NODE_ENV=production
PORT=8000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/artube?retryWrites=true&w=majority

# Generate separate random values of at least 32 characters.
JWT_SECRET=replace_with_a_random_32_character_or_longer_secret
SESSION_SECRET=replace_with_a_different_random_32_character_or_longer_secret

# Public URL of this API after hosting (no trailing slash)
PUBLIC_API_URL=https://your-api-host.example.com
CLIENT_ORIGIN=https://your-app-origin.example.com

UPLOAD_DIR=uploads

# Firebase Admin (use env vars on the host; do not commit service-account.json)
FIREBASE_PROJECT_ID=art-tube
FIREBASE_CLIENT_EMAIL=service-account-name@art-tube.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Bunny.net Stream
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READ_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_PULL_ZONE=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=arttube/thumbnails
